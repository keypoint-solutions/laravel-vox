{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "@keypoint-solutions/laravel-vox",
    "version": "1.0.0",
    "private": false,
    "description": "A Laravel translation manager with AI backing and a friendly management GUI.",
    "author": {
        "name": "Costin Bereveanu",
        "email": "cbereveanu@gmail.com",
        "url": "https://github.com/schniper"
    },
    "license": "MIT",
    "homepage": "https://github.com/keypoint-solutions/laravel-vox#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/keypoint-solutions/laravel-vox.git"
    },
    "bugs": {
        "url": "https://github.com/keypoint-solutions/laravel-vox/issues"
    },
    "type": "module",
    "files": [
        "resources/js/consumer"
    ],
    "exports": {
        "./vite": {
            "types": "./resources/js/consumer/vite.d.ts",
            "import": "./resources/js/consumer/vite.js"
        },
        "./vue": {
            "types": "./resources/js/consumer/vue.d.ts",
            "import": "./resources/js/consumer/vue.js"
        },
        "./vue/runtime": {
            "types": "./resources/js/consumer/runtime.d.ts",
            "import": "./resources/js/consumer/runtime.js"
        }
    },
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "prepare": "husky"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.1.18",
        "@types/node": "^26.1.1",
        "@vitejs/plugin-vue": "^6.0.3",
        "blade-formatter": "^1.44.2",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-unused-imports": "^4.3.0",
        "eslint-plugin-vue": "^10.10.0",
        "globals": "^17.0.0",
        "husky": "^9.1.7",
        "laravel-vite-plugin": "^3.1.3",
        "lint-staged": "^17.2.0",
        "prettier": "^3.7.4",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.52.0",
        "vite": "^8.1.5",
        "vue-eslint-parser": "^10.2.0"
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.6.1",
        "@lucide/vue": "^1.26.0",
        "@vueuse/core": "^14.3.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "laravel-vue-i18n": "^2.8.0",
        "tailwind-merge": "^3.4.0",
        "tailwindcss": "^4.1.1",
        "tw-animate-css": "^1.4.0",
        "vue": "^3.5.13"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "^4.62.2",
        "@rollup/rollup-win32-x64-msvc": "^4.62.2",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
        "lightningcss-win32-x64-msvc": "^1.29.1"
    }
}
