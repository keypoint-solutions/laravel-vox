{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "@keypoint-solutions/laravel-vox",
    "version": "1.0.19",
    "private": false,
    "description": "A Laravel translation manager with AI backing and a friendly management GUI.",
    "author": {
        "name": "Costin Bereveanu",
        "email": "cbereveanu@gmail.com",
        "url": "https://github.com/schniper"
    },
    "license": "MIT",
    "homepage": "https://github.com/keypoint-solutions/laravel-vox#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/keypoint-solutions/laravel-vox.git"
    },
    "bugs": {
        "url": "https://github.com/keypoint-solutions/laravel-vox/issues"
    },
    "type": "module",
    "files": [
        "resources/js/consumer",
        "CHANGELOG.md"
    ],
    "exports": {
        "./vite": {
            "types": "./resources/js/consumer/vite.d.ts",
            "import": "./resources/js/consumer/vite.js"
        },
        "./vue": {
            "types": "./resources/js/consumer/vue.d.ts",
            "import": "./resources/js/consumer/vue.js"
        },
        "./vue/runtime": {
            "types": "./resources/js/consumer/runtime.d.ts",
            "import": "./resources/js/consumer/runtime.js"
        }
    },
    "scripts": {
        "test:hooks": "node --test tests/js/private-docs-hooks.test.mjs",
        "test:consumer": "node --test tests/js/consumer.test.mjs tests/js/vite.test.mjs",
        "test:inertia": "node --test tests/js/inertia.test.mjs",
        "build": "vite build",
        "dev": "vite",
        "type-check": "vue-tsc --noEmit",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "prepare": "husky"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@inertiajs/vue3": "^3.9.1",
        "@lucide/vue": "^1.59.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.5",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vueuse/core": "^14.4.0",
        "blade-formatter": "^1.44.4",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "eslint-plugin-vue": "^10.11.1",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "laravel-vite-plugin": "^3.2.0",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.1.1",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.2",
        "vite": "^8.3.4",
        "vue": "^3.5.44",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^3.3.13"
    },
    "dependencies": {
        "laravel-vue-i18n": "^2.9.0"
    },
    "peerDependencies": {
        "vite": "^8.0.0",
        "vue": "^3.5.13"
    },
    "peerDependenciesMeta": {
        "vite": {
            "optional": true
        }
    }
}
