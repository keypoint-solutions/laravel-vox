{
    "name": "keypoint-solutions/laravel-vox",
    "description": "A Laravel translation manager with AI backing and a friendly management GUI.",
    "keywords": [
        "Keypoint Solutions",
        "laravel",
        "laravel-vox"
    ],
    "homepage": "https://github.com/keypoint-solutions/laravel-vox",
    "license": "MIT",
    "authors": [
        {
            "name": "Costin Bereveanu",
            "email": "cbereveanu@gmail.com",
            "homepage": "https://github.com/schniper",
            "role": "Creator"
        }
    ],
    "require": {
        "php": "^8.2 || ^8.3 || ^8.4",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "inertiajs/inertia-laravel": "^2.0 || ^3.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/boost": "^2.0",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^9.15 || ^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0",
        "pestphp/pest-plugin-arch": "^3.0 || ^4.0",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0",
        "spatie/laravel-ray": "^1.35"
    },
    "autoload": {
        "psr-4": {
            "KeypointSolutions\\LaravelVox\\": "src/",
            "KeypointSolutions\\LaravelVox\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KeypointSolutions\\LaravelVox\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "dev": "npm run dev",
        "test": [
            "@test:package",
            "@test:consumer",
            "@test:ui"
        ],
        "test:package": "vendor/bin/pest",
        "test:ui": [
            "npm run build",
            "@php test-app/artisan vox:setup --force",
            "@php test-app/artisan migrate --force",
            "@php test-app/artisan vox:sync --no-interaction",
            "npm --prefix test-app run build",
            "composer --working-dir=test-app test:browser"
        ],
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "lint": [
            "@php vendor/bin/pint --ansi"
        ],
        "test:consumer": "npm run test:consumer"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "KeypointSolutions\\LaravelVox\\LaravelVoxServiceProvider"
            ],
            "aliases": {
                "LaravelVox": "KeypointSolutions\\LaravelVox\\Facades\\LaravelVox"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
