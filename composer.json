{
    "name": "keypoint-solutions/laravel-vox",
    "description": "A Laravel translation manager with AI backing and a friendly management GUI.",
    "keywords": [
        "Keypoint Solutions",
        "laravel",
        "laravel-vox"
    ],
    "homepage": "https://github.com/keypoint-solutions/laravel-vox",
    "license": "MIT",
    "authors": [
        {
            "name": "Costin Bereveanu",
            "email": "cbereveanu@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2 || ^8.3 || ^8.4",
        "illuminate/contracts": "^11.0||^12.0",
        "inertiajs/inertia-laravel": "^2.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/boost": "^1.8",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^10.0.0||^9.0.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "spatie/laravel-ray": "^1.35"
    },
    "autoload": {
        "psr-4": {
            "KeypointSolutions\\LaravelVox\\": "src/",
            "KeypointSolutions\\LaravelVox\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KeypointSolutions\\LaravelVox\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php vendor/bin/testbench pail --timeout=0\" \"npm run dev\" --names=logs,vite --kill-others"
        ],
        "post-autoload-dump": "@composer run prepare",
        "post-update-cmd": "@php vendor/bin/testbench boost:update --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "KeypointSolutions\\LaravelVox\\LaravelVoxServiceProvider"
            ],
            "aliases": {
                "LaravelVox": "KeypointSolutions\\LaravelVox\\Facades\\LaravelVox"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
