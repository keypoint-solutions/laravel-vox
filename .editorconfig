root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# Markdown — keep trailing whitespace (for line breaks)
[*.md]
trim_trailing_whitespace = false

# YAML (conventional 2 spaces)
[*.{yml,yaml}]
indent_size = 2
