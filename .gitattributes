# Path-based git attributes
# https://www.kernel.org/pub/software/scm/git/docs/gitattributes.html

# Development-only files are left out of Composer installs with "export-ignore".
# Keep /package.json and /resources/js/consumer: both are used from vendor/ at runtime.
/.agents                 export-ignore
/.ai                     export-ignore
/.bladeformatterrc.json  export-ignore
/.codex                  export-ignore
/.editorconfig           export-ignore
/.gitattributes          export-ignore
/.github                 export-ignore
/.github-disabled        export-ignore
/.gitignore              export-ignore
/.husky                  export-ignore
/.prettierignore         export-ignore
/AGENTS.md               export-ignore
/SPEC.md                 export-ignore
/boost.json              export-ignore
/docs                    export-ignore
/eslint.config.mjs       export-ignore
/lint-staged.config.mjs  export-ignore
/package-lock.json       export-ignore
/phpunit.xml.dist        export-ignore
/pint.json               export-ignore
/prettier.config.mjs     export-ignore
/test-app                export-ignore
/tests                   export-ignore
/tsconfig.json           export-ignore
/vite.config.ts          export-ignore

# Dashboard sources: Composer installs use the prebuilt bundle in /dist.
/resources/css             export-ignore
/resources/js/components   export-ignore
/resources/js/composables  export-ignore
/resources/js/layouts      export-ignore
/resources/js/lib          export-ignore
/resources/js/pages        export-ignore
/resources/js/types        export-ignore
/resources/js/vox.ts       export-ignore
